# TLS는 Caddy가 알아서 받는다(Let's Encrypt HTTP-01). 80번이 열려 있어야 챌린지가 통과한다 —
# 방화벽에서 80을 닫으면 인증서 발급이 조용히 실패하고 443만 죽은 채로 남는다.

{$DOCSURI_DOMAIN} {
	encode zstd gzip

	# **SSE가 먼저다.** `handle`은 상호 배타적이고 위에서부터 맞는 것 하나만 탄다 —
	# 아래의 `/api/*`를 먼저 두면 이벤트 스트림이 그쪽으로 빨려 들어가 버퍼링이 걸린다.
	# 그러면 진행 이벤트가 턴이 끝날 때 한꺼번에 도착하고, 화면에는 "진행 표시가 멈춰 있다"로
	# 보인다(에이전트가 느린 것과 구분되지 않는다). `flush_interval -1`이 그것을 끈다.
	handle /api/evidence/turns/*/events {
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}

	handle /api/novelty/jobs/*/events {
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}

	# 나머지 API. Next의 catch-all 라우트가 `/api/*`를 먹기 때문에 이 블록이 없으면
	# 백엔드로 가야 할 요청이 프론트의 404로 끝난다.
	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 3
		}
	}
}
