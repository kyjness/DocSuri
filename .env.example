# DocSuri local profile — 이 파일을 .env로 복사해서 채운다(.env는 gitignored).

# --- stores (backend/docker-compose.yml) ---
# 평문 postgresql:// 로 둘 것. SQLAlchemy식 postgresql+psycopg:// 를 쓰면 raw-psycopg
# 소비자(요약 용어집 repo)가 DSN 파싱에 실패한다 — db.py가 필요할 때 +psycopg를 알아서 붙인다.
DATABASE_URL=postgresql://docsuri:docsuri@localhost:5432/docsuri
REDIS_HOST=localhost
DOCSURI_OPENSEARCH_ENDPOINT=http://localhost:9200
DOCSURI_OPENSEARCH_USE_SSL=0
DOCSURI_OPENSEARCH_VERIFY_CERTS=0

# --- S3 substitute (s3proxy serving the mirror as bucket "docsuri") ---
# AWS_ACCESS_KEY_ID / SECRET을 여기 두지 말 것. s3proxy용 가짜 값을 넣으면 boto3가 환경변수를
# 프로필보다 먼저 읽어 그 값이 **Bedrock 호출까지 덮어쓴다** — 진짜 자격증명을 넣어도 임베딩·
# 요약·에이전트가 전부 UnrecognizedClientException으로 죽는데, S3는 멀쩡해서 프로바이더 장애로
# 오인하기 쉽다. s3proxy 인증을 끄고(S3PROXY_AUTHORIZATION=none) 이 자리를 비워 둔다.
AWS_ENDPOINT_URL_S3=http://localhost:9000
AWS_DEFAULT_REGION=ap-northeast-2
# 어느 자격증명을 쓸지 명시한다. ~/.aws/config의 [default]가 만료된 SSO를 가리키면 지정하지
# 않았을 때 SSOTokenLoadError로 떨어진다.   생성: aws configure --profile docsuri-deploy
AWS_PROFILE=docsuri-deploy
DOCSURI_S3_BUCKET=docsuri
DOCSURI_DOCMODEL_BUCKET=docsuri

# --- GROBID (ingestion parser; opt-in) ---
# Only needed to (re-)ingest LOCALLY — the PDF/GROBID tier and ALL non-arXiv sources (S2/OpenAlex).
# Since the 2026-08-10 ladder revision this is also the arXiv fallback rung: an arXiv paper whose
# ar5iv build is missing/broken goes PDF→GROBID, and with no GROBID it is EXCLUDED from the corpus
# (no flat-text doc-model anymore). Serving the pre-built doc-model mirror does NOT need it.
# Uncomment AND start the container:
#   docker compose -f backend/docker-compose.yml --profile ingest up -d grobid
# DOCSURI_GROBID_URL=http://localhost:8070

# --- Semantic Scholar / OpenAlex corpus sources (opt-in; need GROBID above) ---
# The runtime builds these adapters only when DOCSURI_GROBID_URL is set (their PDFs are parsed by
# GROBID). Collection-side only: they DISCOVER non-arXiv papers; they are not a parsing fallback
# for arXiv papers (an arXiv preprint's only host is arXiv — measured 2026-08-10, BR-30).
# Both work keyless: S2 without a key is rate-limited hard (single lookups 429 in practice);
# OpenAlex relaxes its limits when mailto identifies the caller.
# DOCSURI_CORPUS_SOURCES=ARXIV,SEMANTIC_SCHOLAR,OPENALEX
# DOCSURI_SEMANTIC_SCHOLAR_API_KEY=
# 연락처 2종 — API 키가 아니므로 발급 절차가 없고, 소스를 켜기 전에 채워 두는 편이 낫다.
# MAILTO 없이 OpenAlex를 호출하면 폴라이트 풀이 아니라 공용 풀로 떨어져 한도가 낮고 429가 잦다.
# CONTACT_EMAIL은 아웃바운드 User-Agent에 실려 출판사가 요청자를 식별하는 값이다.
# DOCSURI_OPENALEX_MAILTO=you@example.com
# DOCSURI_CONTACT_EMAIL=you@example.com

# 위 셋(S2 키·MAILTO·CONTACT)은 **U11 근거형성의 실시간 조회도 같이 쓴다.** 자격증명 이름은
# 소비자가 아니라 자격증명 자체를 가리키므로 U11 전용 이름을 따로 파지 않는다 — 같은 키를 두
# 이름으로 두면 언젠가 한쪽만 채워진 배포가 나온다.
#
# 실시간 조회(설계 v3 §3.2) = 코퍼스 밖 논문을 arXiv·S2·OpenAlex에서 찾는 `live_lookup` 도구.
# **기본은 off다** — 켜면 턴마다 코퍼스 밖으로 나가는 호출이 생기므로 켜는 것은 결정이다.
# 꺼져 있으면 도구가 아예 등록되지 않아 모델에게 보이지도 않는다(조용히 실패하지 않는다).
# 앞선 `external_search`(arXiv 하나)는 이 파일에도 CDK에도 플래그가 없어 배포에서 한 번도
# 돈 적이 없다 — 코드에만 있고 아무도 그 사실을 몰랐다. 그래서 여기에 적는다.
# DOCSURI_EVIDENCE_LIVE_LOOKUP_ENABLED=true
# DOCSURI_EVIDENCE_LIVE_LOOKUP_TIMEOUT_MS=15000
# DOCSURI_EVIDENCE_CAP_LIVE_LOOKUP=3   # 세 소스 **합산** 턴당 호출 수
#
# **S2는 키가 있을 때만 합류한다.** 무키 공용 풀은 사실상 항상 429다(2026-08-25 실측:
# 12초 간격 5회 연속 429, 요청 모양은 정상). 키 없이 매 턴 부르면 왕복만 버리고 화면에
# "실시간 조회가 온전히 돌지 못했어요"가 상시로 뜬다 — 미구성을 장애로 보여주면 진짜
# 장애가 묻힌다. 키가 없으면 arXiv·OpenAlex 둘로 돈다.

# --- LLM / embeddings ---
# Bedrock is the only provider. Embeddings (U1 writer + U2 reader) and every LLM call (U7
# summarize/translate, U11 evidence, U12 novelty) go through it, so credentials come from the
# ambient AWS identity — an IAM role in the deploy, `aws configure` locally. There is no
# provider switch: a second vendor could not be dropped in by config anyway, because the
# corpus is embedded in one space and swapping the embedding model silently invalidates it.
#
# 임베딩 모델 id는 U2 검색 마운트의 게이트다(endpoint AND model id). 비우면 discovery가
# "미구성"으로 스킵돼 /api/search가 404가 되므로, 색인을 만든 모델과 **같은 값**을 둔다.
DOCSURI_BEDROCK_MODEL_ID=cohere.embed-v4:0
# Cohere 임베드 모델은 서울(ap-northeast-2)에 없다 — OpenSearch SigV4 리전과 분리해 교차
# 리전으로 부른다. 비우면 AWS_DEFAULT_REGION으로 떨어져 모델 미존재로 실패한다.
DOCSURI_BEDROCK_REGION=us-east-1
DOCSURI_EMBED_REGION=us-east-1
DOCSURI_SUMMARY_BUCKET=docsuri
DOCSURI_DOCMODEL_VIEWER_ENABLED=1
# Run long summaries/translations on a background thread and answer `pending` so the client
# polls, instead of holding the request open past its deadline. The deploy does this with SQS and
# a worker process (DOCSURI_SUMMARY_JOB_QUEUE_URL); this is the single-process equivalent, and
# without either a long generation is reported to the user as a failure while it quietly finishes.
DOCSURI_LOCAL_SUMMARY_WORKER=1

# --- 롤아웃 게이트 ---
# 기본 off인 유닛은 라우터 전체가 404가 된다(인증 앞단 dependency가 먼저 raise). 회귀가
# 아니라 미활성인데 "깨졌다"로 오인하기 쉬우니, 404를 보면 플래그부터 확인할 것.
PERSONALIZATION_ENABLED=1   # u9 — /api/personalization/*
CITATION_GRAPH_ENABLED=1    # u8 — /api/papers/{id}/citation-tree

# --- frontend-facing links (verification/reset mails point at the FE pages) ---
PUBLIC_APP_URL=http://localhost:3000

# --- U2 cross-encoder rerank (FR-3), optional ---
# Presence of the ARN is the whole feature toggle: set → the real reranker is wired; absent →
# the fused RRF order ships as-is. There is no shadow mode — wiring it means it is live.
# The rerank model does NOT exist in the Seoul deploy region and has no global inference
# profile, so the ARN must name a region that carries it (Tokyo). The region is read back OUT
# of the ARN, which is why DOCSURI_RERANK_REGION can stay unset.
# Note: the per-account request-rate quota trips on ordinary bursts; a throttled call fails
# soft to the baseline order and logs a WARNING (it does not surface to the user).
# DOCSURI_RERANK_MODEL_ARN=arn:aws:bedrock:ap-northeast-1::foundation-model/cohere.rerank-v3-5:0
